<% provide :no_header, true %>

<div class="page-theme">
  <div class="page-gradient"></div>

  <%= image_tag(page.icon_url, alt: "#{page.title}のアイコン", class: "page-icon") %>

  <h1><%= page.title %></h1>

  <div>
    <%= md_render page.description %>
  </div>

  <div id="question_form">
    <details>
      <summary>質問asする</summary>
      <%= render "questions/form", page_aid: page.aid, question: Question.new, url: page_questions_path(page.aid) %>
    </details>
  </div>

  <div id="blocks">
    <%= turbo_frame_tag "blocks" do %>
      <%= render partial: "blocks/block", collection: page.blocks.is_normal.ordered, as: "block" %>
    <% end %>
  </div>

  <% if page.account == @current_account %>
    <div class="page-owner">
      <p>あなたはこのページの所有者です。</p>
      <%= link_to "編集", edit_page_path(page.aid) %>
      <%= link_to "質問", page_questions_path(page.aid) %>
    </div>
  <% end %>

</div>

<style>
  .page-gradient1 {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    height: 200px;
    min-width: 800px;
    mask-image: linear-gradient(to bottom, #000, #0000);
    background: linear-gradient(90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(42, 123, 155, 1) 15%,
      rgba(87, 199, 133, 1) 50%,
      rgba(237, 221, 83, 1) 85%,
      rgba(255, 255, 255, 0) 100%);
  }
  .page-gradient {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    min-width: 600px;
    z-index: -1;
    height: 700px;
    background-image: radial-gradient(at 0% 100%, hsl(0deg 0% 100% / 0%) 0px, transparent 50%), 
                      radial-gradient(at 50% 100%, hsl(0deg 0% 100% / 0%) 0px, transparent 50%), 
                      radial-gradient(at 100% 109%, hsl(0deg 0% 100% / 0%) 0px, transparent 50%), 
                      radial-gradient(at 50% -10%, hsla(70, 78%, 69%, 1) 0px, transparent 50%), 
                      radial-gradient(at 85% 20%, hsla(313, 98%, 69%, 1) 0px, transparent 50%), 
                      radial-gradient(at 17% 16%, hsla(233, 82%, 64%, 1) 0px, transparent 50%);
}
  main {
    --page-font-color: <%= page.font_color.presence || "#000000" %>;
    --page-block-color: <%= page.block_color.presence || "#FFFFFF" %>;
    --page-accent-color: <%= page.accent_color.presence || "#F42C70" %>;
    --page-bg-image: none;
    --page-bg-overlay: none;
    --page-bg-gradient: none;
    --page-bg-color: transparent;
    --page-bg-size: auto;
    --page-bg-position: 0% 0%;
    --page-bg-attachment: scroll;
    --page-background-color: <%= page.background_color.presence || "#F0F0F0" %>;
    --page-gradient-color: <%= page.gradient_color.presence || "#D0D0D0" %>;
    position: relative;
    overflow: hidden;

    <% if page.background.present? %>
      --page-bg-image: url("<%= page.background_url %>");
      --page-bg-overlay: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5));
      --page-bg-size: cover;
      --page-bg-position: center;
      --page-bg-attachment: fixed;
    <% elsif page.background_color.present? && page.gradient_color.present? %>
      --page-bg-gradient: linear-gradient(to bottom right, <%= page.background_color %>, <%= page.gradient_color %>);
    <% elsif page.background_color.present? %>
      --page-bg-color: <%= page.background_color %>;
    <% elsif page.gradient_color.present? %>
      --page-bg-color: <%= page.gradient_color %>;
    <% else %>
      --page-bg-gradient: linear-gradient(to bottom right, #f0f0f0, #d0d0d0);
    <% end %>
  }

  main::before {
    background-image: var(--page-bg-overlay), var(--page-bg-image), var(--page-bg-gradient);
    background-size: var(--page-bg-size);
    background-position: var(--page-bg-position);
    background-attachment: var(--page-bg-attachment);
    background-color: var(--page-bg-color);

    content: "";
    position: absolute;
    inset: 0px;
    /* filter: blur(6px) brightness(0.85); */
    /* transform: scale(1.05); */
    z-index: -1;
  }

  .page-theme {
    color: var(--page-font-color);
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-theme a {
    color: var(--page-accent-color);
  }

  .page-theme .block:hover {
    background-color: var(--page-block-color);
  }

  .page-theme .ctmf input[type="submit"],
  .page-theme .ctmf-button {
    border: 2px solid var(--page-accent-color);
    background: transparent;
    color: var(--page-accent-color);
  }

  .page-theme hr {
    border-color: var(--page-accent-color);
  }
</style>
