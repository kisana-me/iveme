<% content_for :title, @page.title %>

<h1><%= @page.title %></h1>

<div>
  <strong>ID:</strong> <%= @page.name_id %>
  <br />
  <strong>公開日:</strong> <%= @page.created_at.strftime("%Y-%m-%d") %>
  <br />
  <strong>更新日:</strong> <%= @page.updated_at.strftime("%Y-%m-%d") %>
  <% if @page.account == @current_account %>
    <br />
    <strong>編集:</strong> <%= link_to "編集", edit_page_path(@page.aid) %>
  <% end %>
</div>

<hr />

<div>
  <%= md_render @page.description %>
</div>

<hr />

<div id="blocks">
  <%= turbo_frame_tag "blocks" do %>
    <%= render partial: "blocks/block", collection: @page.blocks.is_normal.ordered, as: "block" %>
  <% end %>
</div>
