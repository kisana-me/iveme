<%= form_with(
  model: page,
  url: url,
  class: "ctmf",
  data: {
    turbo: false,
    controller: "image-preview",
    "image-preview-default-icon-url-value": full_url("/static_assets/images/icon.png"),
    "image-preview-has-icon-value": page.icon_id.present?,
    "image-preview-has-background-value": page.background_id.present?,
    page_has_background_image: page.background_id.present?
  }
) do |form| %>
  <%= render "shared/error_messages", instead: page %>

  <%= image_tag(page.icon_url, alt: "#{page.title}のアイコン", class: "page-icon", data: { "image-preview-target": "icon" }) %>

  <div>
    <%= form.label :icon_file, "ページアイコン画像" %>
    <%= form.file_field :icon_file, data: { "image-preview-target": "iconInput", action: "change->image-preview#iconChanged" } %>
    <label data-image-preview-target="removeIconRow" style="display: <%= page.icon_id.present? ? 'block' : 'none' %>; margin-top: .5rem;">
      <%= form.check_box :remove_icon, data: { "image-preview-target": "removeIconToggle", action: "change->image-preview#removeIconToggled" } %>
      アイコン画像を削除
    </label>
  </div>

  <div>
    <%= form.label :background_file, "ページ背景画像" %>
    <%= form.file_field :background_file, data: { "image-preview-target": "backgroundInput", action: "change->image-preview#backgroundChanged" } %>
    <label data-image-preview-target="removeBackgroundRow" style="display: <%= page.background_id.present? ? 'block' : 'none' %>; margin-top: .5rem;">
      <%= form.check_box :remove_background, data: { "image-preview-target": "removeBackgroundToggle", action: "change->image-preview#removeBackgroundToggled" } %>
      背景画像を削除
    </label>
  </div>

  <div>
    <% flag = defined?(is_first_page) ? is_first_page : false %>
    <%= form.label :name_id, "Page Id" %>
    <small>英数字とアンダースコア(_)のみ、1~20文字である必要があります</small>
    <% if flag %>
    <small>最初のページであるため "index" に固定されます</small>
    <% end %>
    <%= form.text_field :name_id, value: (flag ? "index" : page.name_id), disabled: flag %>
  </div>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :font_color, "文字色" %>
    <small>未設定ならデフォルト</small>
    <div data-controller="color-picker" data-color-picker-default-color-value="#000000" data-color-picker-css-var-value="--page-font-color">
      <%= form.hidden_field :font_color, data: { "color-picker-target": "hidden" } %>
      <input type="color" value="<%= page.font_color.presence || '#000000' %>" data-color-picker-target="picker" data-action="input->color-picker#pick" />
      <label style="margin-left: .5rem;">
        <input type="checkbox" data-color-picker-target="defaultToggle" data-action="color-picker#toggleDefault" <%= page.font_color.blank? ? 'checked' : '' %> />
        デフォルト
      </label>
    </div>
  </div>

  <div>
    <%= form.label :block_color, "ブロック色" %>
    <small>未設定ならデフォルト</small>
    <div data-controller="color-picker" data-color-picker-default-color-value="#FFFFFF" data-color-picker-css-var-value="--page-block-color">
      <%= form.hidden_field :block_color, data: { "color-picker-target": "hidden" } %>
      <input type="color" value="<%= page.block_color.presence || '#FFFFFF' %>" data-color-picker-target="picker" data-action="input->color-picker#pick" />
      <label style="margin-left: .5rem;">
        <input type="checkbox" data-color-picker-target="defaultToggle" data-action="color-picker#toggleDefault" <%= page.block_color.blank? ? 'checked' : '' %> />
        デフォルト
      </label>
    </div>
  </div>

  <div>
    <%= form.label :accent_color, "リンク・アクセント色" %>
    <small>未設定ならデフォルト</small>
    <div data-controller="color-picker" data-color-picker-default-color-value="#F42C70" data-color-picker-css-var-value="--page-accent-color">
      <%= form.hidden_field :accent_color, data: { "color-picker-target": "hidden" } %>
      <input type="color" value="<%= page.accent_color.presence || '#F42C70' %>" data-color-picker-target="picker" data-action="input->color-picker#pick" />
      <label style="margin-left: .5rem;">
        <input type="checkbox" data-color-picker-target="defaultToggle" data-action="color-picker#toggleDefault" <%= page.accent_color.blank? ? 'checked' : '' %> />
        デフォルト
      </label>
    </div>
  </div>

  <div>
    <%= form.label :background_color, "背景色" %>
    <small>未設定ならデフォルト</small>
    <div data-controller="color-picker" data-color-picker-default-color-value="#F0F0F0" data-color-picker-css-var-value="--page-background-color">
      <%= form.hidden_field :background_color, data: { "color-picker-target": "hidden" } %>
      <input type="color" value="<%= page.background_color.presence || '#F0F0F0' %>" data-color-picker-target="picker" data-action="input->color-picker#pick" />
      <label style="margin-left: .5rem;">
        <input type="checkbox" data-color-picker-target="defaultToggle" data-action="color-picker#toggleDefault" <%= page.background_color.blank? ? 'checked' : '' %> />
        デフォルト
      </label>
    </div>
  </div>

  <div>
    <%= form.label :gradient_color, "グラデーション色(2色目)" %>
    <small>背景色と両方ある場合はグラデーションになります。未設定ならデフォルト</small>
    <div data-controller="color-picker" data-color-picker-default-color-value="#D0D0D0" data-color-picker-css-var-value="--page-gradient-color">
      <%= form.hidden_field :gradient_color, data: { "color-picker-target": "hidden" } %>
      <input type="color" value="<%= page.gradient_color.presence || '#D0D0D0' %>" data-color-picker-target="picker" data-action="input->color-picker#pick" />
      <label style="margin-left: .5rem;">
        <input type="checkbox" data-color-picker-target="defaultToggle" data-action="color-picker#toggleDefault" <%= page.gradient_color.blank? ? 'checked' : '' %> />
        デフォルト
      </label>
    </div>
  </div>

  <div>
    <%= form.submit "送信" %>
  </div>
<% end %>
