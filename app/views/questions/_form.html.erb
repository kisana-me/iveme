<div data-controller="turnstile"
     data-turnstile-environment-value="<%= Rails.env %>"
     data-turnstile-sitekey-value="<%= ENV.fetch("CLOUDFLARE_TURNSTILE_SITE_KEY") %>">
<%= form_with(model: question, url: url, local: false, class: "ctmf") do |form| %>
  <%= render "shared/error_messages", instead: question %>
  <%= hidden_field_tag :page_aid, (local_assigns[:page_aid] || params[:page_aid]) %>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content, rows: 6 %>
  </div>

  <div class="cf-turnstile" data-turnstile-target="widget"></div>

  <div>
    <%= form.submit "送信", data: { turnstile_target: "submit" }, disabled: true %>
  </div>
<% end %>
</div>
