<%= turbo_frame_tag "block_#{block.aid}" do %>
  <div class="block" id="block_<%= block.aid %>">
    <% if block.title.present? %>
      <h3><%= block.title %></h3>
    <% end %>

    <% if block.description.present? %>
      <p>
        <%= block.description %>
      </p>
    <% end %>

    <% if block.url.present? %>
      <div class="block-url">
        <a href="<%= block.url %>" target="_blank" rel="noopener"><%= block.url %></a>
      </div>
    <% end %>

    <% if block.page.account == @current_account %>
      <div>
        <%= link_to "Edit", edit_block_path(block.aid), class: "" %>
        <%= button_to "Delete", block_path(block.aid), method: :delete, data: { confirm: "Are you sure?" }, class: "" %>
        <%= button_to "▲", up_block_path(block.aid), method: :patch, class: "" %>
        <%= button_to "▼", down_block_path(block.aid), method: :patch, class: "" %>
      </div>
    <% end %>
  </div>
<% end %>
