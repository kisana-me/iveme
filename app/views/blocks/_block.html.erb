<%= turbo_frame_tag "block_#{block.aid}" do %>
  <div class="block" id="block_<%= block.aid %>">

    <div class="block-content">
      <% if block.title.present? %>
        <h3>
          <%= block.title %>
        </h3>
      <% end %>

      <% if block.description.present? %>
        <p>
          <%= block.description %>
        </p>
      <% end %>

      <% if block.url.present? %>
        <%= link_to block.url, block.url, target: "_blank", rel: "noopener nofollow" %>
      <% end %>
    </div>

    <% if defined? editable %>
      <div class="block-actions">
        <div>
          <%= button_to "Edit", edit_block_path(block.aid), method: :get, class: "block-action" %>
          <%= button_to "Delete", block_path(block.aid), method: :delete, data: { turbo_confirm: "ブロックを削除しますか？" }, class: "block-action", style: "color: red;" %>
        </div>
        <div>
          <%= button_to "▲", up_block_path(block.aid), method: :patch, class: "block-action" %>
          <%= button_to "▼", down_block_path(block.aid), method: :patch, class: "block-action" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
