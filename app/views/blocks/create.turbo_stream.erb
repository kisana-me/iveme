<%= turbo_stream.append "blocks", partial: "blocks/block", locals: { block: @block, editable: true } %>

<%= turbo_stream.update "new_block" do %>
  <%= button_to "ブロック追加", new_block_path(), params: {page_aid: @page.aid}, method: :get, data: { turbo_frame: "new_block" }, class: "ctmf-button" %>
<% end %>

<%= turbo_stream.update "flash", partial: "shared/flash" %>
